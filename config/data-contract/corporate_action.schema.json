{
  "$id": "corporate_action.schema.json",
  "type": "object",
  "required": [
    "action_id",
    "type",
    "ex_date",
    "available_at",
    "source_timestamp_type"
  ],
  "additionalProperties": false,
  "properties": {
    "action_id": { "type": "string" },
    "type": {
      "type": "string",
      "enum": [
        "split",
        "bonus",
        "dividend",
        "rights",
        "merger",
        "demerger",
        "symbol_change",
        "isin_change",
        "suspension",
        "delisting"
      ]
    },
    "ex_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "factor": { "type": "number" },
    "available_at": { "type": "string" },
    "source_timestamp_type": {
      "type": "string",
      "enum": ["exchange", "filing", "vendor", "derived"]
    },
    "timestamp_quality": { "type": "string", "enum": ["exact", "date_only"] },
    "source": { "type": "string" },
    "source_version": { "type": "number" }
  },
  "forbidden_fields": ["date"],
  "supported_for_research_adjustment": ["split", "bonus"],
  "calendar_only": ["dividend"],
  "unsupported": [
    "rights",
    "merger",
    "demerger",
    "symbol_change",
    "isin_change",
    "suspension",
    "delisting"
  ]
}
