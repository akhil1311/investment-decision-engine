{
  "$id": "benchmark.schema.json",
  "type": "object",
  "required": [
    "benchmark_id",
    "trading_date",
    "close",
    "available_at",
    "source_timestamp_type"
  ],
  "additionalProperties": false,
  "properties": {
    "benchmark_id": { "type": "string", "const": "NIFTY50_PRICE_INDEX" },
    "trading_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "close": { "type": "number" },
    "available_at": { "type": "string" },
    "source_timestamp_type": {
      "type": "string",
      "enum": ["exchange", "filing", "vendor", "derived"]
    },
    "timestamp_quality": { "type": "string", "enum": ["exact", "date_only"] },
    "source": { "type": "string" }
  },
  "forbidden_fields": ["date"],
  "notes": "Nifty 50 price index — not total return"
}
