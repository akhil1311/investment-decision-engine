{
  "$id": "event.schema.json",
  "type": "object",
  "required": [
    "event_id",
    "type",
    "event_date",
    "available_at",
    "source_version",
    "source_timestamp_type"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": "string" },
    "type": { "type": "string", "enum": ["earnings", "ex_date"] },
    "event_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "available_at": { "type": "string" },
    "source_version": { "type": "number" },
    "source_timestamp_type": {
      "type": "string",
      "enum": ["exchange", "filing", "vendor", "derived"]
    },
    "timestamp_quality": { "type": "string", "enum": ["exact", "date_only"] },
    "source": { "type": "string" }
  },
  "forbidden_fields": ["date"]
}
